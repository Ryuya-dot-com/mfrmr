\description{
Render a Wright map, pathway map, category probability curves (CCC), or
consolidated diagnostic/comparison view from a fitted \code{\link[=fit_mfrm]{fit_mfrm()}} object.
Invisibly returns a \code{ggplot} object carrying underlying tables and notes via
\code{\link[=plot_data]{plot_data()}} and \code{\link[=plot_data_components]{plot_data_components()}}.
}
\details{
\strong{Scale, conditioning, and display payloads.} Higher Person locations raise
expected coded scores; under default negative facet orientation, higher
non-Person locations indicate greater severity/difficulty (\code{positive_facets}
reverses sign). Pathway and CCC curves hold non-target additive facets and
interactions at zero (\code{curve_basis}). Boundary-clipped coordinates record
\code{OriginalEstimate} separately from \code{DisplayEstimate}, and blocked-fit extreme
MML EAPs are recorded in \code{person_exclusions}.
}
\section{Visual diagnostics map, presets, and missing-interval states}{
\tabular{ll}{
   Question \tab Primary \code{plot()} route \cr
   Shared logit targeting of Persons, facets, and steps \tab \code{plot(fit, type = "wright")} \cr
   Expected scores and category probability curves \tab \code{plot(fit, type = "pathway")} or \code{type = "ccc"} \cr
   Model-fit overview and response screens \tab \code{plot(fit, type = "qc")}, \code{"unexpected"}, \code{"displacement"}, \code{"marginal_fit"} \cr
   Inter-rater score agreement vs residual structure \tab \code{plot(fit, type = "agreement")}, \code{"residual_pca"}, \code{"local_dependence"}, \code{"bias"} \cr
   Connectedness, anchor drift, or group DFF \tab \code{plot(result)} on \code{\link[=subset_connectivity_report]{subset_connectivity_report()}}, \code{\link[=detect_anchor_drift]{detect_anchor_drift()}}, or \code{\link[=analyze_dff]{analyze_dff()}} \cr
}


\strong{Session defaults and editing.} Set \code{options(mfrmr.plot_preset = "publication")} (\code{"standard"}, \code{"publication"}, \code{"compact"}, or
\code{"monochrome"}) for a session preset; explicit \code{preset} overrides the option
and \code{preset = NULL} uses \code{"standard"}. Every \code{plot()} method returns a
\code{ggplot} invisibly (\code{draw = FALSE} suppresses device drawing). Titles and
explanatory notes stay outside the canvas by default (\code{show_title = FALSE},
\code{show_notes = FALSE}) and remain accessible via \code{plot_data(p, "title")} and
\code{plot_data(p, "notes")}.

\strong{Missing estimates and intervals.} Retain rows with \code{NA} bounds alongside
their \code{Status}, \code{CIEligible}, \code{CoverageQualified}, and \code{InferenceReview}
fields: \code{fixed} marks constraint-pinned coordinates, \code{prior_only} marks
Persons without observed responses, and \code{CoverageQualified = FALSE} records
unestablished finite-sample nominal coverage rather than numerical failure.
See \code{vignette("mfrmr-visual-diagnostics", package = "mfrmr")}.
}

\examples{
library(mfrmr)

# Saved synthetic MML/RSM analysis of example_operational.
# For your own data, fit a model first; see ?fit_mfrm.
example_fit <- readRDS(system.file("examples", "operational-mml.rds", package = "mfrmr"))
fit <- example_fit$fit

# Run each plot command separately to inspect its figure
plot(fit) # Wright map: persons, facets, and category thresholds

# Rater severity estimates (higher means more severe in this example)
plot(fit, type = "facet", facet = "Rater")

# Probability of each score category across the ability scale
plot(fit, type = "ccc")

# Optional: get plot without printing and inspect underlying tables
wright <- plot(fit, draw = FALSE)
head(plot_data(wright, "locations"))
# Find a named judge without refitting or dropping the surrounding scale
judge <- subset(plot_data(wright, "locations"), Group == "Rater")$Label[1]
focused <- plot(fit, highlight = list(Rater = judge), draw = FALSE)
subset(plot_data(focused, "locations"), Highlighted)

\dontrun{
# Requires your own file with Person IDs matching the fitted data.
groups <- read.csv("person-groups.csv") # columns: Person, Cohort
grouped <- plot(fit, group = "Cohort", group_data = groups, draw = FALSE)
plot_data(grouped, "group_density")$summary
# Sensitivity to smoothing, keeping the fitted model unchanged:
plot(fit, group = "Cohort", group_data = groups, density_adjust = 1.5)
}
}
