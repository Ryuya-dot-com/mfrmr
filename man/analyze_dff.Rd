\section{Summary controls}{

\itemize{
\item \code{top_n = 30} limits displayed contrasts; \code{sort_by} is \code{"abs_effect"}
(default), \code{"effect"}, or \code{"classification"}.
\item \code{ci_level = NULL} omits intervals. A level such as \code{0.95} requests
approximate normal intervals from available linked-refit standard errors;
residual comparisons require \code{NULL}.
\item \code{effect_thresholds} adds symmetric effect-size guide lines, not
classification boundaries. \code{effect_axis_label} overrides the axis label.
\item \code{preset} is \code{"standard"}, \code{"publication"}, \code{"compact"}, or \code{"monochrome"}.
}
}

\section{Heatmap controls}{

\itemize{
\item \code{metric = "obs_exp"} shows cell mean observed-minus-expected scores;
\code{"t"} shows a descriptive scaled residual, not a t-test. These require
the cell table from \code{method = "residual"}. \code{"contrast"} shows the saved
pairwise group contrasts, on the analysis method's scale.
