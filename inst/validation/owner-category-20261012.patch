+  out <- category_threshold_table(f, NULL, usage)
+  expect_true(out$coverage$NotApplicable)
+  expect_true(all(out$table$SE_Status == "fixed_by_step_centering"))
+  expect_true(all(out$table$CIUse == "not_applicable"))
+})
